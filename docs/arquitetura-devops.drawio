Arrow=block;endFill=1;fontColor=#E5E7EB;fontSize=11;labelBackgroundColor=#121212;exitX=0.75;exitY=1;entryX=0.431;entryY=0;" edge="1" parent="1" source="c6" target="c60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c89" value="fila valence.observatorio" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#FFFFFF;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#E5E7EB;fontSize=11;labelBackgroundColor=#121212;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c57" target="c63"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="545" y="1262"/><mxPoint x="1180" y="1262"/></Array></mxGeometry></mxCell><mxCell id="c90" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1380" y="1100" width="720" height="175" as="geometry"/></mxCell><mxCell id="c91" value='&lt;b&gt;Fluxo DevOps a cada mudança&lt;/b&gt;&lt;br&gt;&lt;font color="#4DA3FF"&gt;&lt;b&gt;1&lt;/b&gt;&lt;/font&gt;  O desenvolvedor cria a Task no Azure Boards.&lt;br&gt;&lt;font color="#4DA3FF"&gt;&lt;b&gt;2&lt;/b&gt;&lt;/font&gt;  Cria a branch pela Task, faz commit com #ID e abre o PR para a main.&lt;br&gt;&lt;font color="#4DA3FF"&gt;&lt;b&gt;3&lt;/b&gt;&lt;/font&gt;  Com revisão e work item vinculado, o merge na main protegida dispara o Build (CI).&lt;br&gt;&lt;font color="#4DA3FF"&gt;&lt;b&gt;4&lt;/b&gt;&lt;/font&gt;  O Build compila com Java 21, roda os testes JUnit e publica os resultados e o artefato.&lt;br&gt;&lt;font color="#4DA3FF"&gt;&lt;b&gt;5&lt;/b&gt;&lt;/font&gt;  O novo artefato valence-api dispara a Release (CD) automaticamente.&lt;br&gt;&lt;font color="#4DA3FF"&gt;&lt;b&gt;6&lt;/b&gt;&lt;/font&gt;  A Release usa a service connection e o grupo de variáveis para publicar o .jar e as App Settings.&lt;br&gt;&lt;font color="#4DA3FF"&gt;&lt;b&gt;7&lt;/b&gt;&lt;/font&gt;  A API grava no Azure SQL (JDBC 1433) e atende o app Mobile e o navegador (HTTPS 443).' style="text;html=1;whiteSpace=wrap;fontColor=#FFFFFF;fontSize=12;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1398" y="1112" width="690" height="155" as="geometry"/></mxCell><mxCell id="c92" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1790" y="490" width="310" height="580" as="geometry"/></mxCell><mxCell id="c93" value="&lt;b&gt;Legenda&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontColor=#FFFFFF;fontSize=12;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=0;fontFamily=Helvetica;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1808" y="504" width="200" height="22" as="geometry"/></mxCell><mxCell id="c94" value="" style="rounded=1;html=1;strokeColor=#FFFFFF;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#E5E7EB;fontSize=11;labelBackgroundColor=#121212;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1808" y="556" as="sourcePoint"/><mxPoint x="1863" y="556" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c95" value="Requisição em execução (HTTPS, JDBC, AMQPS)" style="text;html=1;whiteSpace=wrap;fontColor=#FFFFFF;fontSize=12;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1876" y="547" width="210" height="40" as="geometry"/></mxCell><mxCell id="c96" value="" style="rounded=1;html=1;strokeColor=#4DA3FF;strokeWidth=2;dashed=1;dashPattern=8 5;endArrow=block;endFill=1;fontColor=#E5E7EB;fontSize=11;labelBackgroundColor=#121212;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1808" y="612" as="sourcePoint"/><mxPoint x="1863" y="612" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c97" value="Fluxo CI/CD: código, Build, Release e deploy" style="text;html=1;white